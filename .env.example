# Copy to backend/.env and fill in. Never commit real values.
OPENAI_API_KEY=            # BuilderBase -> Resources -> Reveal
OPENAI_TEXT_MODEL=         # small, fast current model for structured extraction
ELEVENLABS_API_KEY=        # via the event Discord
ELEVENLABS_AGENT_ID=
# Use the n8n Workflow 1 production URL. Leave empty for direct HeatFix dispatch.
N8N_CASE_WEBHOOK_URL=
# Value of the X-N8N-Webhook-Secret Header Auth credential in Workflow 1.
N8N_WEBHOOK_SECRET=
PARTNER_WEBHOOK_SECRET=dev-partner-secret  # local demo default
PUBLIC_BACKEND_URL=http://localhost:8000   # set to your cloudflared https URL for ElevenLabs/n8n
PARTNER_BASE_URL=http://localhost:8000     # mock partners are served by the same backend for now
DATABASE_PATH=./data/app.db
CORS_ORIGINS=http://localhost:5173

# Copy to backend/.env and fill in. Never commit real values.
# Both OpenAI settings are optional. Leave either empty for deterministic intake.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
# Optional voice dictation. Set to gpt-transcribe to enable it.
OPENAI_TRANSCRIPTION_MODEL=
ELEVENLABS_API_KEY=        # via the event Discord
ELEVENLABS_AGENT_ID=
# Provider-neutral n8n workflow (takes precedence when set).
N8N_CONNECTOR_WEBHOOK_URL=
# Separate secret for the authenticated backend dispatch endpoint called by n8n.
CONNECTOR_DISPATCH_SECRET=
# Legacy fixed HeatFix workflow. Leave both webhook URLs empty for direct dispatch.
N8N_CASE_WEBHOOK_URL=
# Value of the X-N8N-Webhook-Secret Header Auth credential on the configured workflow.
N8N_WEBHOOK_SECRET=
# Set the same private value on each process for external partner callbacks.
# When empty, the single-process local demo generates its own secret at startup.
PARTNER_WEBHOOK_SECRET=
PUBLIC_BACKEND_URL=http://localhost:8000   # set to your cloudflared https URL for ElevenLabs/n8n
PARTNER_BASE_URL=http://localhost:8000     # mock partners are served by the same backend for now
DATABASE_PATH=./data/app.db
CORS_ORIGINS=http://localhost:5173

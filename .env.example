# Copy to backend/.env and fill in. Never commit real values.
# Both OpenAI settings are optional. Leave either empty for deterministic intake.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
# Optional voice dictation. Select openai (default) or elevenlabs.
TRANSCRIPTION_PROVIDER=openai
# For OpenAI dictation, set this model (for example, gpt-transcribe) and OPENAI_API_KEY above.
OPENAI_TRANSCRIPTION_MODEL=
# For ElevenLabs dictation, set this key. The backend uses the scribe_v2 model.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Provider-neutral n8n workflow (takes precedence when set).
N8N_CONNECTOR_WEBHOOK_URL=
# Separate secret for the authenticated backend dispatch endpoint called by n8n.
CONNECTOR_DISPATCH_SECRET=
# Legacy fixed HeatFix workflow. Leave both webhook URLs empty for direct dispatch.
N8N_CASE_WEBHOOK_URL=
# Value of the X-N8N-Webhook-Secret Header Auth credential on the configured workflow.
N8N_WEBHOOK_SECRET=
# Set the same private value on each process for external partner callbacks.
# When empty, the single-process local demo generates its own secret at startup.
PARTNER_WEBHOOK_SECRET=
PUBLIC_BACKEND_URL=http://localhost:8000   # set to your cloudflared https URL for ElevenLabs/n8n
PARTNER_BASE_URL=http://localhost:8000     # mock partners are served by the same backend for now
DATABASE_PATH=./data/app.db
CORS_ORIGINS=http://localhost:5173
# Notifications noreply bot. Comma list: outbox (default, nothing leaves), smtp (email), ntfy or telegram (text).
# Example: NOTIFY_TRANSPORT=smtp,ntfy (no accounts or tokens needed). A channel without its transport is recorded as sent_simulated.
NOTIFY_TRANSPORT=outbox
NOTIFY_FROM=centrix <noreply@centrix.example>
# Mailpit: SMTP_HOST=localhost SMTP_PORT=1025, no user. Gmail: smtp.gmail.com, 587, STARTTLS=true, app password.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
# ntfy push server. Each recipient gets a random private topic, shown in its notification preferences.
NTFY_SERVER=https://ntfy.sh
# Bot token from @BotFather. Chat IDs are stored per recipient via the preferences API.
TELEGRAM_BOT_TOKEN=
# Optional manager inbox for invoice_approval emails. Links in messages point here.
NOTIFY_MANAGER_EMAIL=
PUBLIC_FRONTEND_URL=http://localhost:5173
